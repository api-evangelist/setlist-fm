{
  "opencollection": "1.0.0",
  "info": {
    "name": "setlist.fm REST Artists Countries API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Countries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all countries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.setlist.fm/rest/1.0/search/countries"
          },
          "docs": "Returns the complete list of countries known to setlist.fm."
        }
      ]
    }
  ],
  "bundled": true
}